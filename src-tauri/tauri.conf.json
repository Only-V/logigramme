{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logigramme",
  "version": "1.0.0",
  "identifier": "io.github.onlyv.logigramme",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Logigramme",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
